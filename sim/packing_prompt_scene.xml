<!--
  Illustrative rendering of stored action differences;
  not closed-loop SmolVLA–LIBERO execution.

  This compact MJCF deliberately uses simple geometric proxies. The moving
  end effector and task objects are positioned from stored episode data by
  sim/mujoco_prompt_animation.py; this is not a robot dynamics model.
-->
<mujoco model="illustrative packing prompt comparison">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="640" offheight="360"/>
    <headlight ambient="0.30 0.30 0.30" diffuse="0.72 0.72 0.72"/>
    <quality shadowsize="2048" offsamples="4"/>
    <map znear="0.01" zfar="8"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.72 0.82 0.91" rgb2="0.97 0.98 1.0"
             width="256" height="1024"/>
    <texture name="wood" type="2d" builtin="checker"
             rgb1="0.33 0.18 0.10" rgb2="0.42 0.24 0.14"
             width="512" height="512"/>
    <material name="table_wood" texture="wood" texrepeat="5 5"
              texuniform="true" reflectance="0.08"/>
    <material name="robot_silver" rgba="0.68 0.72 0.77 1"
              specular="0.65" shininess="0.45"/>
    <material name="basket" rgba="0.76 0.88 0.92 1"
              specular="0.15" shininess="0.15"/>
  </asset>

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light name="key" pos="-0.65 -0.70 1.65" dir="0.35 0.35 -1"
           diffuse="0.92 0.90 0.86" specular="0.25 0.25 0.25"/>
    <light name="fill" pos="0.70 -0.25 1.10" dir="-0.4 0.15 -1"
           diffuse="0.45 0.50 0.58" specular="0.10 0.10 0.12"/>
    <camera name="presentation" pos="0 -1.10 1.22"
            xyaxes="1 0 0 0 0.75 1" fovy="45"/>

    <!-- Tabletop: top surface is z=0.40, matching the stored pose range. -->
    <geom name="table" type="box" pos="0.02 0.02 0.34"
          size="0.48 0.49 0.06" material="table_wood"/>

    <!-- Basket centered near the two visually reviewed episode-0 openings. -->
    <body name="basket" pos="-0.002 0.265 0.405">
      <geom name="basket_floor" type="box" pos="0 0 0.010"
            size="0.115 0.105 0.010" material="basket"/>
      <geom name="basket_left" type="box" pos="-0.115 0 0.075"
            size="0.010 0.115 0.075" material="basket"/>
      <geom name="basket_right" type="box" pos="0.115 0 0.075"
            size="0.010 0.115 0.075" material="basket"/>
      <geom name="basket_front" type="box" pos="0 -0.105 0.075"
            size="0.105 0.010 0.075" material="basket" rgba="0.68 0.84 0.90 0.72"/>
      <geom name="basket_back" type="box" pos="0 0.105 0.075"
            size="0.105 0.010 0.075" material="basket"/>
      <geom name="basket_rim_left" type="capsule" fromto="-0.128 -0.115 0.155 -0.128 0.115 0.155"
            size="0.010" rgba="0.28 0.61 0.70 1"/>
      <geom name="basket_rim_right" type="capsule" fromto="0.128 -0.115 0.155 0.128 0.115 0.155"
            size="0.010" rgba="0.28 0.61 0.70 1"/>
    </body>

    <!-- Static robot base; moving links are visual capsules added at render time. -->
    <body name="robot_base" pos="-0.30 -0.27 0.40">
      <geom type="cylinder" pos="0 0 0.055" size="0.075 0.055"
            material="robot_silver"/>
      <geom type="cylinder" pos="0 0 0.165" size="0.050 0.080"
            material="robot_silver"/>
      <geom type="sphere" pos="0 0 0.265" size="0.065"
            material="robot_silver"/>
    </body>

    <!-- A few scene-context proxies; only the two named task objects move. -->
    <geom name="tomato_can" type="cylinder" pos="-0.23 0.08 0.445"
          size="0.030 0.045" rgba="0.76 0.16 0.12 1"/>
    <geom name="juice_box" type="box" pos="-0.20 -0.12 0.455"
          size="0.030 0.025 0.055" rgba="0.93 0.48 0.10 1"/>

    <body name="cream_cheese" mocap="true" pos="0.098 -0.203 0.430">
      <geom name="cream_cheese_geom" type="box" size="0.047 0.030 0.025"
            rgba="0.82 0.90 1.0 1"/>
      <geom type="box" pos="0 -0.031 0" size="0.039 0.002 0.018"
            rgba="0.18 0.40 0.78 1"/>
    </body>
    <body name="butter" mocap="true" pos="0.069 0.020 0.420">
      <geom name="butter_geom" type="box" size="0.045 0.024 0.018"
            rgba="1.0 0.76 0.16 1"/>
      <geom type="box" pos="0 -0.025 0" size="0.034 0.002 0.011"
            rgba="0.90 0.34 0.08 1"/>
    </body>

    <!-- Moving end-effector proxy and independently positioned jaws. -->
    <body name="eef" mocap="true" pos="0 0 0.65">
      <geom name="eef_palm" type="box" size="0.055 0.030 0.025"
            material="robot_silver"/>
      <geom type="cylinder" pos="0 0 0.045" size="0.028 0.035"
            material="robot_silver"/>
    </body>
    <body name="left_jaw" mocap="true" pos="-0.035 0 0.60">
      <geom type="box" size="0.012 0.018 0.045" rgba="0.18 0.21 0.24 1"/>
    </body>
    <body name="right_jaw" mocap="true" pos="0.035 0 0.60">
      <geom type="box" size="0.012 0.018 0.045" rgba="0.18 0.21 0.24 1"/>
    </body>
  </worldbody>
</mujoco>
